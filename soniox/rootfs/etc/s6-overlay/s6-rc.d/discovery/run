#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Tell Home Assistant where the Wyoming service is.
# ==============================================================================
declare config

# Wait for the bridge to accept connections
bash -c \
    "until
        echo '{ \"type\": \"describe\" }' \
            > /dev/tcp/localhost/10500; do sleep 0.5;
    done" > /dev/null 2>&1 || true;

config=$(\
    bashio::var.json \
        uri "tcp://$(hostname):10500" \
)

if bashio::discovery "wyoming" "${config}" > /dev/null; then
    bashio::log.info "Sent discovery information to Home Assistant."
else
    bashio::log.error "Discovery message to Home Assistant failed!"
fi
